# ============================================================================
# VIVAH KAR LO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual private credentials.
# NEVER commit the actual '.env' file to Git or public repositories.
# ============================================================================

# 1. CORE SERVER SETTINGS
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
APP_NAME="Vivah Kar Lo"
APP_URL=http://localhost:3001

# 2. CRYPTOGRAPHY, SESSION & JWT SECRETS
SESSION_SECRET=replace_with_a_secure_random_session_secret_32_bytes_hex
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_bytes_hex
ENCRYPTION_KEY=replace_with_32_byte_hex_key
BCRYPT_SALT_ROUNDS=10

# 3. SUPER ADMIN CREDENTIALS & 2FA PIN
ADMIN_EMAIL=admin@vivahkarlo.in
ADMIN_PASSWORD=replace_with_secure_admin_password
ADMIN_PIN=123456

# Backward compatibility keys
ADMIN_DEFAULT_EMAIL=admin@vivahkarlo.in
ADMIN_DEFAULT_PASSWORD=replace_with_secure_admin_password
ADMIN_2FA_PIN=123456

# 4. SUPABASE DATABASE CONFIGURATION (PostgreSQL)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 5. CLIENT-SIDE SUPABASE KEYS (Vite Exposed)
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# 6. MESSAGING & NOTIFICATIONS
SMS_PROVIDER=none
SMS_API_KEY=
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_DIR=./server/data/baileys_auth
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# 7. PAYMENT GATEWAY MODE (Manual UPI QR & Bank Transfer)
PAYMENT_GATEWAY_MODE=manual
MANUAL_PAYMENT_ENABLED=true
MANUAL_UPI_ID=vivahkarlo@upi
MANUAL_ACCOUNT_HOLDER="Vivah Kar Lo Matrimonial Services"
MANUAL_ACCOUNT_NUMBER=919876543210
MANUAL_IFSC_CODE=SBIN0001234
MANUAL_BANK_NAME="State Bank of India"
